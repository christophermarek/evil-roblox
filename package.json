{
  "name": "evil-robloxia",
  "version": "0.1.0",
  "description": "Evil Robloxia — a player-as-villain town sandbox built with roblox-ts + Flamework + Rojo",
  "private": true,
  "scripts": {
    "build": "rbxtsc",
    "watch": "rbxtsc -w",
    "dev": "concurrently --kill-others --names \"rbxtsc,rojo\" -c \"cyan,magenta\" \"rbxtsc -w\" \"rojo serve\""
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@rbxts/compiler-types": "^3.0.0-types.0",
    "@rbxts/types": "^1.0.925",
    "concurrently": "^10.0.3",
    "rbxts-transformer-flamework": "^1.3.2",
    "roblox-ts": "^3.0.0",
    "typescript": "^5.5.3"
  },
  "dependencies": {
    "@flamework/core": "^1.3.2",
    "@flamework/networking": "^1.3.2",
    "@rbxts/roact": "^3.0.1",
    "@rbxts/services": "^1.6.0"
  }
}
